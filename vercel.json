{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/jobs/nightly",
      "schedule": "15 8 * * *"
    },
    {
      "path": "/api/jobs/close-auctions",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/jobs/reports",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/jobs/title-vetting",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/jobs/live-auctions",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/jobs/ended-auctions",
      "schedule": "5 */6 * * *"
    }
  ]
}
