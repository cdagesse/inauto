# Copy to .env.local. Never commit real values.

# Postgres (Neon via Vercel Marketplace). Pooled URL for the app, direct URL for migrations.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:pass@host/db?sslmode=require

# Clerk (Vercel Marketplace). `vercel env pull` provides both keys.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/signin
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
# Svix signing secret from the Clerk dashboard webhook endpoint (user.created/updated/deleted).
CLERK_WEBHOOK_SIGNING_SECRET=
# Salt for truncated IP hashes. Generate with: openssl rand -base64 32
IP_HASH_SALT=

# Scheduled jobs. Vercel sets CRON_SECRET automatically when a cron is configured; set one locally.
CRON_SECRET=
JOBS_DRY_RUN=true

# Third-party market data. Read only inside scheduled jobs, never in a page request.
VISOR_API_KEY=
VISOR_MONTHLY_BUDGET=2000
OCD_API_KEY=
OCD_MONTHLY_BUDGET=1000

# Motomarks (https://motomarks.io) car brand logos. The publishable token is safe in the browser.
# Leave empty to show monogram tiles instead of logos. Free tier is 1,000 requests/day with attribution.
NEXT_PUBLIC_MOTOMARKS_TOKEN=

# Claude API key for the listing description assistant (server only). Leave empty to hide the feature.
ANTHROPIC_API_KEY=

# Vitu title checks (OAuth 2.0 client credentials). Sandbox defaults are baked in; set stage/prod URLs to switch.
VITU_CLIENT_ID=
VITU_CLIENT_SECRET=
# VITU_AUTH_URL=https://auth.test.vitu.com/realms/api/protocol/openid-connect/token
# VITU_API_BASE=https://api-test.vitu.com
# VITU_SCOPE=oneapi:access
# Title/NMVTIS report endpoint from Vitu's API spec (portal login). Leave unset until known; the job idles.
VITU_TITLE_PATH=
VITU_TITLE_METHOD=POST
