# Copy to .env.local. Never commit real values.

# Postgres (Neon via Vercel Marketplace). Pooled URL for the app, direct URL for migrations.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:pass@host/db?sslmode=require

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# OAuth providers are optional; each appears on the sign-in page only when both values are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Local-only email/password sign-in for development. Ignored in production.
AUTH_DEV_LOGIN=true

# Scheduled jobs. Vercel sets CRON_SECRET automatically when a cron is configured; set one locally.
CRON_SECRET=
JOBS_DRY_RUN=true

# Third-party market data. Read only inside scheduled jobs, never in a page request.
VISOR_API_KEY=
VISOR_MONTHLY_BUDGET=2000
OCD_API_KEY=
OCD_MONTHLY_BUDGET=1000
